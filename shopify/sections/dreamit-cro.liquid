{% comment %}
  Dream It Israel — Conversion Rate Optimization Kit (Shopify section)

  INSTALL:
    1. Online Store → Themes → Edit code → Sections → Add a new section
       → name it "dreamit-cro" → paste this file's contents.
    2. In Layout → theme.liquid, add this line just before </body>:
         {% section 'dreamit-cro' %}
    3. Customize the settings in Online Store → Customize (the section appears
       on every page; its settings control all features).

  All features are toggleable, theme-agnostic (injected via JS next to your
  theme's own product form / cart form), and fire Microsoft Clarity +
  dataLayer events so impact is measurable. Safe to remove at any time.
{% endcomment %}

{%- liquid
  assign fs_threshold = section.settings.free_shipping_threshold
  assign is_product = false
  if template contains 'product' and product
    assign is_product = true
    assign cur_variant = product.selected_or_first_available_variant
  endif
-%}

<style>
.dcro-fsbar{background:#f0f9f2;border:1px solid #bfe6c8;border-radius:10px;padding:12px 16px;margin:0 0 16px;text-align:center;direction:rtl}
.dcro-fsbar-text{margin:0 0 8px;font-size:15px}
.dcro-fsbar-done{color:#1a7f37}
.dcro-fsbar-track{background:#dfeee3;border-radius:99px;height:9px;overflow:hidden}
.dcro-fsbar-fill{background:linear-gradient(90deg,#34c759,#1a7f37);height:100%;border-radius:99px;transition:width .4s}
.dcro-pdp{direction:rtl;margin:14px 0}
.dcro-lowstock{color:#c2410c;background:#fff4ec;border-radius:8px;padding:8px 12px;font-size:14px;display:inline-block;margin:0 0 10px}
.dcro-delivery{font-size:14px;line-height:1.7;margin:0 0 4px}
.dcro-delivery p{margin:2px 0}
.dcro-countdown{color:#c2410c;font-variant-numeric:tabular-nums;font-weight:700}
.dcro-badges{list-style:none;margin:12px 0 0;padding:12px 0 0;border-top:1px solid #eee;display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;font-size:13.5px}
.dcro-badges li{display:flex;align-items:center;gap:8px;margin:0}
.dcro-badge-icon{font-size:17px}
.dcro-sticky{position:fixed;bottom:0;left:0;right:0;z-index:9998;background:#fff;box-shadow:0 -4px 18px rgba(0,0,0,.12);display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 16px;transform:translateY(110%);transition:transform .25s;direction:rtl}
.dcro-sticky.dcro-on{transform:none}
.dcro-sticky-info{display:flex;flex-direction:column;min-width:0}
.dcro-sticky-name{font-weight:600;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:38vw}
.dcro-sticky-price{font-size:14px;color:#1a7f37;font-weight:700}
.dcro-sticky-actions{display:flex;gap:8px}
.dcro-sticky-btn{background:#1a7f37;color:#fff;border:0;border-radius:8px;padding:12px 18px;font-size:15px;font-weight:700;cursor:pointer;white-space:nowrap}
.dcro-sticky-btn:hover{background:#166b2f}
.dcro-buynow-btn{background:#111;color:#fff;border:0;border-radius:8px;padding:12px 14px;font-size:14px;font-weight:700;cursor:pointer;white-space:nowrap}
.dcro-wa{position:fixed;bottom:86px;left:16px;z-index:9997;width:54px;height:54px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(0,0,0,.25)}
.dcro-exit{position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:20px;direction:rtl}
.dcro-exit[hidden]{display:none}
.dcro-exit-box{background:#fff;border-radius:14px;max-width:380px;width:100%;padding:30px 26px;text-align:center;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.dcro-exit-close{position:absolute;top:8px;right:12px;background:none;border:0;font-size:26px;cursor:pointer;color:#999;line-height:1}
.dcro-exit-title{font-size:21px;font-weight:800;margin:0 0 6px}
.dcro-exit-sub{font-size:15px;color:#444;margin:0 0 14px}
.dcro-exit-code{font-size:20px;font-weight:800;letter-spacing:2px;background:#f6f6f6;border:2px dashed #bbb;border-radius:8px;padding:10px;margin:0 0 16px}
.dcro-exit-cta{display:block;background:#1a7f37;color:#fff !important;border-radius:8px;padding:13px;font-weight:700;text-decoration:none !important}
.dcro-cart-trust{display:flex;flex-wrap:wrap;gap:8px 18px;justify-content:center;margin:14px 0;font-size:13px;color:#555;direction:rtl}
@media(max-width:768px){.dcro-badges{font-size:12.5px}}
</style>

{%- comment -%} ── Templates injected by JS next to the theme's own markup ── {%- endcomment -%}

{%- if section.settings.enable_fsbar and template contains 'cart' -%}
<template id="dcro-t-fsbar">
  <div class="dcro-fsbar" data-dcro-view="dcro_fs_bar_view">
    {%- assign fs_cents = fs_threshold | times: 100 -%}
    {%- if cart.total_price < fs_cents -%}
      {%- assign remaining = fs_cents | minus: cart.total_price -%}
      <p class="dcro-fsbar-text">הוסיפו עוד <strong>{{ remaining | money }}</strong> וקבלו <strong>משלוח חינם!</strong></p>
      {%- assign pct = cart.total_price | times: 100 | divided_by: fs_cents -%}
    {%- else -%}
      <p class="dcro-fsbar-text dcro-fsbar-done">🎉 מגיע לכם <strong>משלוח חינם</strong> על ההזמנה הזו!</p>
      {%- assign pct = 100 -%}
    {%- endif -%}
    <div class="dcro-fsbar-track"><div class="dcro-fsbar-fill" style="width:{{ pct }}%"></div></div>
  </div>
</template>
{%- endif -%}

{%- if is_product -%}
<template id="dcro-t-pdp">
  <div class="dcro-pdp">
    {%- if section.settings.enable_lowstock
        and cur_variant.inventory_management == 'shopify'
        and cur_variant.inventory_quantity > 0
        and cur_variant.inventory_quantity <= section.settings.low_stock_threshold -%}
      <p class="dcro-lowstock">🔥 נשארו רק <strong>{{ cur_variant.inventory_quantity }}</strong> יחידות במלאי</p>
    {%- endif -%}
    {%- if section.settings.enable_delivery -%}
      <div class="dcro-delivery" id="dcro-delivery"></div>
    {%- endif -%}
    {%- if section.settings.enable_badges -%}
      <ul class="dcro-badges">
        <li><span class="dcro-badge-icon">🚚</span>{{ section.settings.badge_1 }}</li>
        <li><span class="dcro-badge-icon">🛡️</span>{{ section.settings.badge_2 }}</li>
        <li><span class="dcro-badge-icon">🔒</span>{{ section.settings.badge_3 }}</li>
        <li><span class="dcro-badge-icon">💬</span>{{ section.settings.badge_4 }}</li>
      </ul>
    {%- endif -%}
  </div>
</template>

{%- if section.settings.enable_sticky -%}
<div class="dcro-sticky" id="dcro-sticky" aria-hidden="true">
  <div class="dcro-sticky-info">
    <span class="dcro-sticky-name">{{ product.title | escape }}</span>
    <span class="dcro-sticky-price">{{ cur_variant.price | money }}</span>
  </div>
  <div class="dcro-sticky-actions">
    {%- if section.settings.enable_buynow -%}
    <button type="button" class="dcro-buynow-btn" id="dcro-buynow" data-dcro-event="dcro_buy_now">⚡ לתשלום מהיר</button>
    {%- endif -%}
    <button type="button" class="dcro-sticky-btn" id="dcro-sticky-add" data-dcro-event="dcro_sticky_add">הוספה לסל</button>
  </div>
</div>
{%- endif -%}
{%- endif -%}

{%- if section.settings.enable_cart_trust and template contains 'cart' -%}
<template id="dcro-t-cart-trust">
  <div class="dcro-cart-trust">
    <span>🔒 תשלום מאובטח ומוצפן</span>
    <span>🛡️ {{ section.settings.badge_2 }}</span>
    <span>📞 שירות לקוחות ישראלי</span>
  </div>
</template>
{%- endif -%}

{%- if section.settings.enable_whatsapp and section.settings.whatsapp_phone != blank -%}
{%- liquid
  assign wa_phone = section.settings.whatsapp_phone | remove: '+' | remove: '-' | remove: ' '
  if is_product
    assign wa_msg = 'היי, יש לי שאלה על "' | append: product.title | append: '" — ' | append: shop.url | append: product.url
  else
    assign wa_msg = 'היי, אשמח לעזרה 🙂'
  endif
-%}
<a class="dcro-wa" data-dcro-event="dcro_whatsapp_click" target="_blank" rel="noopener nofollow"
   href="https://wa.me/{{ wa_phone }}?text={{ wa_msg | url_encode }}" aria-label="WhatsApp">
  <svg viewBox="0 0 32 32" width="30" height="30" fill="#fff" aria-hidden="true"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.5c1.2.6 2.5.9 3.8.9 6.6 0 12-5.4 12-12S22.6 3 16 3zm6.6 16.9c-.3.8-1.6 1.5-2.2 1.6-.6.1-1.3.2-3.7-.8-3.1-1.3-5.1-4.4-5.3-4.6-.2-.2-1.3-1.7-1.3-3.2s.8-2.3 1.1-2.6c.3-.3.6-.4.8-.4h.6c.2 0 .5-.1.7.5l1 2.4c.1.2.1.4 0 .6l-.4.7-.6.6c-.2.2-.4.4-.2.7.2.4 1 1.6 2.1 2.6 1.4 1.3 2.6 1.7 3 1.9.4.2.6.2.8-.1l1-1.2c.2-.3.4-.3.7-.2l2.2 1c.3.2.6.3.7.4.1.3.1.9-.2 1.7z"/></svg>
</a>
{%- endif -%}

{%- if section.settings.enable_exit and section.settings.exit_coupon_code != blank -%}
{%- unless template contains 'cart' -%}
<div class="dcro-exit" id="dcro-exit" hidden data-cooldown="{{ section.settings.exit_cooldown_days | default: 7 }}">
  <div class="dcro-exit-box" role="dialog" aria-modal="true" aria-label="הטבה מיוחדת">
    <button type="button" class="dcro-exit-close" aria-label="סגירה">&times;</button>
    <p class="dcro-exit-title">רגע לפני שעוזבים… 🎁</p>
    <p class="dcro-exit-sub">{{ section.settings.exit_coupon_text }}</p>
    <p class="dcro-exit-code">{{ section.settings.exit_coupon_code }}</p>
    <a class="dcro-exit-cta" data-dcro-event="dcro_exit_popup_claim"
       href="/discount/{{ section.settings.exit_coupon_code | url_encode }}?redirect=/collections/all">למימוש ההטבה</a>
  </div>
</div>
{%- endunless -%}
{%- endif -%}

<script>
(function(){
"use strict";
var CFG = {
  isProduct: {% if is_product %}true{% else %}false{% endif %},
  cutoffHour: {{ section.settings.cutoff_hour | default: 14 }},
  deliveryDays: {{ section.settings.delivery_days | default: 7 }},
  deliveryEnabled: {% if section.settings.enable_delivery %}true{% else %}false{% endif %}
};
function tag(n){try{if(window.clarity)clarity("event",n);if(window.dataLayer)dataLayer.push({event:n});}catch(e){}}
document.addEventListener("click",function(e){
  var el=e.target.closest("[data-dcro-event]");
  if(el)tag(el.getAttribute("data-dcro-event"));
});
function inject(tplId,target,where){
  var t=document.getElementById(tplId);
  if(!t||!target)return null;
  var node=t.content.firstElementChild.cloneNode(true);
  target.insertAdjacentElement(where,node);
  if(node.hasAttribute("data-dcro-view"))tag(node.getAttribute("data-dcro-view"));
  return node;
}
function ready(fn){document.readyState==="loading"?document.addEventListener("DOMContentLoaded",fn):fn();}

ready(function(){
  var main=document.querySelector("main")||document.body;

  // Cart page: free-shipping bar above the cart form, trust strip below it
  var cartForm=main.querySelector('form[action="/cart"],form[action^="/cart?"]');
  if(cartForm){
    inject("dcro-t-fsbar",cartForm,"beforebegin");
    inject("dcro-t-cart-trust",cartForm,"afterend");
  }

  // Product page: inject block after the add-to-cart form
  var atcForm=main.querySelector('form[action*="/cart/add"]')||document.querySelector('form[action*="/cart/add"]');
  if(CFG.isProduct&&atcForm){
    inject("dcro-t-pdp",atcForm,"afterend");

    // Delivery promise + dispatch countdown (Asia/Jerusalem, Sun–Thu business days)
    var box=document.getElementById("dcro-delivery");
    if(box&&CFG.deliveryEnabled){
      function ilNow(){return new Date(new Date().toLocaleString("en-US",{timeZone:"Asia/Jerusalem"}));}
      function isBiz(d){var w=d.getDay();return w!==5&&w!==6;} // Fri=5, Sat=6
      var now=ilNow(),sameDay=isBiz(now)&&now.getHours()<CFG.cutoffHour;
      var dispatch=new Date(now);
      if(!sameDay){do{dispatch.setDate(dispatch.getDate()+1);}while(!isBiz(dispatch));}
      var arrive=new Date(dispatch);
      for(var i=0;i<CFG.deliveryDays;i++){do{arrive.setDate(arrive.getDate()+1);}while(!isBiz(arrive));}
      var html="";
      if(sameDay){
        var cut=new Date(now);cut.setHours(CFG.cutoffHour,0,0,0);
        html+='<p>🚚 הזמינו בתוך <span class="dcro-countdown" data-deadline="'+cut.getTime()+'">--:--</span> והחבילה יוצאת לדרך <strong>עוד היום</strong></p>';
      }
      html+='<p>📦 צפי אספקה עד יום '+new Intl.DateTimeFormat("he-IL",{weekday:"long",day:"numeric",month:"long"}).format(arrive)+"</p>";
      box.innerHTML=html;
      var cd=box.querySelector(".dcro-countdown");
      if(cd){
        var end=parseInt(cd.getAttribute("data-deadline"),10),off=Date.now()-ilNow().getTime();
        (function tick(){
          var s=Math.max(0,Math.floor((end+off-Date.now())/1000));
          var h=Math.floor(s/3600),m=Math.floor(s%3600/60);
          cd.textContent=h+":"+String(m).padStart(2,"0")+" שעות";
          if(s>0)setTimeout(tick,30000);
        })();
      }
    }

    // Sticky bar
    var sticky=document.getElementById("dcro-sticky");
    if(sticky&&"IntersectionObserver"in window){
      new IntersectionObserver(function(en){
        var vis=en[0].isIntersecting;
        sticky.classList.toggle("dcro-on",!vis);
        sticky.setAttribute("aria-hidden",vis?"true":"false");
      },{rootMargin:"-60px 0px 0px 0px"}).observe(atcForm);
      var addBtn=document.getElementById("dcro-sticky-add");
      if(addBtn)addBtn.addEventListener("click",function(){
        var submit=atcForm.querySelector('[type="submit"],button[name="add"]');
        if(submit&&!submit.disabled){submit.click();}
        else{atcForm.scrollIntoView({behavior:"smooth",block:"center"});}
      });
      var buyBtn=document.getElementById("dcro-buynow");
      if(buyBtn)buyBtn.addEventListener("click",function(){
        var idInput=atcForm.querySelector('[name="id"]');
        var qtyInput=atcForm.querySelector('[name="quantity"]');
        var qty=qtyInput&&parseInt(qtyInput.value,10)>0?parseInt(qtyInput.value,10):1;
        if(idInput&&idInput.value){window.location.href="/cart/"+idInput.value+":"+qty;}
        else{atcForm.scrollIntoView({behavior:"smooth",block:"center"});}
      });
    }
  }

  // Exit-intent popup
  var exitEl=document.getElementById("dcro-exit");
  if(exitEl){
    var KEY="dcro_exit_shown",days=parseInt(exitEl.getAttribute("data-cooldown"),10)||7,shown=false;
    try{shown=!!(localStorage.getItem(KEY)&&Date.now()<parseInt(localStorage.getItem(KEY),10));}catch(e){}
    function show(){
      if(shown)return;shown=true;
      try{localStorage.setItem(KEY,String(Date.now()+days*864e5));}catch(e){}
      exitEl.hidden=false;tag("dcro_exit_popup_view");
    }
    if(!shown){
      document.addEventListener("mouseout",function(e){if(!e.relatedTarget&&e.clientY<=8)show();});
      var lastY=0,engaged=false;
      setTimeout(function(){engaged=true;},20000);
      window.addEventListener("scroll",function(){
        var y=window.scrollY;
        if(engaged&&lastY-y>350&&y<600)show();
        lastY=y;
      },{passive:true});
    }
    exitEl.addEventListener("click",function(e){
      if(e.target===exitEl||e.target.closest(".dcro-exit-close"))exitEl.hidden=true;
    });
  }
});
})();
</script>

{% schema %}
{
  "name": "Dreamit CRO Kit",
  "settings": [
    { "type": "header", "content": "משלוח חינם" },
    { "type": "checkbox", "id": "enable_fsbar", "label": "פס התקדמות למשלוח חינם (עמוד עגלה)", "default": true },
    { "type": "number", "id": "free_shipping_threshold", "label": "סף משלוח חינם (₪)", "default": 300 },

    { "type": "header", "content": "עמוד מוצר" },
    { "type": "checkbox", "id": "enable_sticky", "label": "סרגל הוספה-לסל צף", "default": true },
    { "type": "checkbox", "id": "enable_buynow", "label": "כפתור תשלום מהיר בסרגל הצף", "default": true },
    { "type": "checkbox", "id": "enable_badges", "label": "תגי אמון מתחת לכפתור הקנייה", "default": true },
    { "type": "text", "id": "badge_1", "label": "תג 1", "default": "משלוח חינם מעל ₪300" },
    { "type": "text", "id": "badge_2", "label": "תג 2", "default": "אחריות 12 חודשים" },
    { "type": "text", "id": "badge_3", "label": "תג 3", "default": "תשלום מאובטח 100%" },
    { "type": "text", "id": "badge_4", "label": "תג 4", "default": "שירות אישי ומענה מהיר" },
    { "type": "checkbox", "id": "enable_delivery", "label": "הבטחת משלוח + שעון עצר למשלוח היום", "default": true },
    { "type": "range", "id": "cutoff_hour", "label": "שעת קאט-אוף למשלוח באותו יום", "min": 8, "max": 20, "step": 1, "default": 14 },
    { "type": "range", "id": "delivery_days", "label": "ימי אספקה (ימי עסקים) — לשמור זהה לפיד ZAP", "min": 1, "max": 14, "step": 1, "default": 7 },
    { "type": "checkbox", "id": "enable_lowstock", "label": "התראת מלאי נמוך (מהמלאי האמיתי בלבד)", "default": true },
    { "type": "range", "id": "low_stock_threshold", "label": "סף מלאי נמוך", "min": 1, "max": 20, "step": 1, "default": 5 },

    { "type": "header", "content": "וואטסאפ" },
    { "type": "checkbox", "id": "enable_whatsapp", "label": "כפתור וואטסאפ צף", "default": true },
    { "type": "text", "id": "whatsapp_phone", "label": "מספר בפורמט בינלאומי (למשל 972501234567)", "default": "" },

    { "type": "header", "content": "פופאפ יציאה" },
    { "type": "checkbox", "id": "enable_exit", "label": "פופאפ קופון ביציאה", "default": true },
    { "type": "text", "id": "exit_coupon_code", "label": "קוד קופון (צרו קודם ב-Discounts)", "default": "" },
    { "type": "text", "id": "exit_coupon_text", "label": "טקסט ההטבה", "default": "5% הנחה על ההזמנה הראשונה שלכם" },
    { "type": "range", "id": "exit_cooldown_days", "label": "ימים בין הצגות למבקר", "min": 1, "max": 30, "step": 1, "default": 7 },

    { "type": "header", "content": "עגלה" },
    { "type": "checkbox", "id": "enable_cart_trust", "label": "רצועת אמון בעמוד העגלה", "default": true }
  ]
}
{% endschema %}
