# Public URL of this mirror site (without trailing slash)
MIRROR_BASE_URL=https://mirror.dreamitisrael.com

# Port to listen on
PORT=3000

# Default product values
DEFAULT_SHIPMENT_COST=0
DEFAULT_DELIVERY_TIME=3
DEFAULT_WARRANTY=12 חודשים
DEFAULT_WARRANTY_BY=Dream It Israel

# Optional: WooCommerce REST API (faster & more reliable than scraping)
# Get keys from: WP Admin → WooCommerce → Settings → Advanced → REST API
WC_API_URL=https://www.dreamitisrael.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxx

# Optional: protect the /admin/refresh endpoint
ADMIN_TOKEN=change_me_to_a_secret
